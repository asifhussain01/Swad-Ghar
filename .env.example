# SwadGhar Platform Global Environment Variables Example
PORT=5000
NODE_ENV=development

# MongoDB Atlas Database URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.es5eufp.mongodb.net/swadghar?retryWrites=true&w=majority

# JWT Security
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Initial Super Admin Seed Credentials
ADMIN_NAME=SwadGhar Admin
ADMIN_EMAIL=admin@swadghar.com
ADMIN_PASSWORD=Admin@SwadGhar2026
ADMIN_PHONE=+919876543210

# Web and Mobile Allowed Origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:19006

# Cloudinary Storage (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
