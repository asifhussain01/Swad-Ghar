# Dependencies across all apps and backend
node_modules/
*/node_modules/
*/*/node_modules/
.pnp
.pnp.js
.npm/
.yarn/
package-lock.json.bak

# Environment & Sensitive Credentials
.env
.env.*
!.env.example
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
*.pem
*.key
*.cert
*.crt
id_rsa*
secrets.json

# Build Outputs & Bundles
dist/
*/dist/
build/
*/build/
out/
web-build/
*/web-build/
*.tsbuildinfo
.eslintcache

# Expo & React Native Metro Caches
.expo/
*/.expo/
.expo-shared/
*/.expo-shared/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Native Mobile Builds (Android / iOS)
android/app/build/
android/.gradle/
android/app/release/
android/app/debug/
android/captures/
ios/Pods/
ios/build/
ios/*.xcworkspace
ios/*.xcuserdata
ios/*.moved-aside
*.ipa
*.apk
*.aab

# Logs, Diagnostics & Runtime
logs/
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
firebase-debug.log*

# Unit Test & Coverage
coverage/
*/coverage/
.nyc_output/
*.lcov

# Editor & IDE Directories
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Temporary files & Caches
.cache/
*/.cache/
.parcel-cache/
tmp/
temp/
